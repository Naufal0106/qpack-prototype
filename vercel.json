{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/p/(.*)",
      "destination": "/consumer/hasil-scan.html"
    },
    {
      "source": "/merchant/kemasan",
      "destination": "/merchant/qr.html"
    },
    {
      "source": "/merchant/qr",
      "destination": "/merchant/qr.html"
    },
    {
      "source": "/merchant/packages",
      "destination": "/merchant/qr.html"
    },
    {
      "source": "/bank-sampah",
      "destination": "/bank-sampah.html"
    },
    {
      "source": "/scan",
      "destination": "/scan.html"
    },
    {
      "source": "/qr",
      "destination": "/scan.html"
    },
    {
      "source": "/impact",
      "destination": "/scan.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register-consumer",
      "destination": "/register-consumer.html"
    },
    {
      "source": "/register-merchant",
      "destination": "/register-merchant.html"
    },
    {
      "source": "/consumer/tukar",
      "destination": "/consumer/scan.html"
    },
    {
      "source": "/consumer",
      "destination": "/consumer/dashboard.html"
    },
    {
      "source": "/merchant/dashboard",
      "destination": "/merchant/dashboard.html"
    },
    {
      "source": "/merchant/produk",
      "destination": "/merchant/produk.html"
    },
    {
