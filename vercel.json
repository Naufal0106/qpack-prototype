      "destination": "/merchant/status-order.html"
    },
    {
      "source": "/merchant/checkout",
      "destination": "/merchant/checkout.html"
    },
    {
      "source": "/merchant/esg",
      "destination": "/merchant/esg.html"
    },
    {
      "source": "/merchant/laporan",
      "destination": "/merchant/laporan.html"
    },
    {
      "source": "/merchant/ai-report",
      "destination": "/merchant/laporan.html"
    },
    {
      "source": "/merchant/akun",
      "destination": "/merchant/akun.html"
