{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/p/(.*)",
      "destination": "/consumer/hasil-scan.html"
    },
    {
      "source": "/merchant/qr",
      "destination": "/merchant/qr.html"
    },
    {
      "source": "/merchant/packages",
      "destination": "/merchant/qr.html"
    }
  ]
}
